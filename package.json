{
  "name": "razzlr",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm lint:deps && turbo run lint",
    "lint:deps": "razzlr-check-deps",
    "test": "turbo run test",
    "e2e": "turbo run e2e"
  },
  "devDependencies": {
    "@razzlr/config": "workspace:*",
    "turbo": "^2.11.10"
  }
}
