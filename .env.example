# Copy to .env (git-ignored) for docker compose. Sign-in with WorkOS (#58) is on when all three
# WORKOS_ settings are set; leave them empty to use the development session only.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# The web app's /callback, registered as a redirect URI in the WorkOS dashboard.
WORKOS_REDIRECT_URI=
# At least 32 characters; a different one for every deployed server.
SESSION_SECRET=
